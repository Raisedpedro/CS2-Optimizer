<Window x:Class="CS2Optimizer.App.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar" SizeToContent="WidthAndHeight" MinWidth="480" MaxWidth="760"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/CS2Optimizer;component/Assets/icone.ico" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" FontSize="20" />
            <ScrollViewer MaxHeight="430" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20" />
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource LinkButton}"
                        Margin="0,0,12,0" Click="Cancel_Click" />
                <Button x:Name="NoButton" Content="Não" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="No_Click" />
                <Button x:Name="YesButton" Content="Sim" Style="{StaticResource PrimaryButton}"
                        Click="Yes_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
