<Window x:Class="CS2Optimizer.App.Dialogs.RestorePointWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ponto de restauração" SizeToContent="WidthAndHeight" MinWidth="500" MaxWidth="720"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/CS2Optimizer;component/Assets/icone.ico" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel>
            <TextBlock Text="Criar um ponto de restauração?" Style="{StaticResource TitleText}" FontSize="20" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20"
                       Text="O programa já faz backup das chaves de registro, do BCD e do plano de energia antes de alterar qualquer coisa. Um ponto de restauração do Windows é uma camada extra de segurança, mas pode demorar alguns minutos e o Windows limita a criação a um ponto a cada 24 horas." />
            <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}"
                       Text="Recomendado: Sim. O ponto de restauração nunca é criado automaticamente." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancelar" Style="{StaticResource LinkButton}" Margin="0,0,12,0"
                        Click="Cancel_Click" />
                <Button Content="Não criar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Click="No_Click" />
                <Button Content="Sim, criar" Style="{StaticResource PrimaryButton}" Click="Yes_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
