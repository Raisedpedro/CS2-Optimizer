<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CS2Optimizer.Core\CS2Optimizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icone.ico" />
    <Resource Include="Assets\Fonts\*.otf" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icone.ico</ApplicationIcon>
    <AssemblyName>CS2Optimizer</AssemblyName>
    <RootNamespace>CS2Optimizer.App</RootNamespace>
    <Version>1.0.14</Version>
    <Product>CS2 / Windows Optimizer</Product>
    <Description>Diagnostico e ajustes seguros e reversiveis para CS2 no Windows 10/11.</Description>
    <Authors>CS2 Optimizer</Authors>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile>
  </PropertyGroup>

</Project>


