<UserControl x:Class="CS2Optimizer.App.Views.Oosu10View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedOosu10" />
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="O&amp;O ShutUp10" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,0"
                           Text="Ajustes de privacidade e telemetria do Windows, com uma recomendação por item. Nada entra sem você marcar, cada mudança é salva antes e pode ser desfeita em Backups / Desfazer." />
                <TextBlock Text="{Binding Oosu10Summary}" Style="{StaticResource MutedText}"
                           Margin="0,6,0,0" />
            </StackPanel>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Selecionar sugeridas p/ CS2" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SelectOosu10PresetCommand}" Margin="0,0,8,0" />
                <Button Content="Limpar seleção" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearOosu10SelectionCommand}" Margin="0,0,8,0" />
                <Button Content="Reverter selecionados" Style="{StaticResource DangerButton}"
                        Command="{Binding RestoreOosu10Command}" Margin="0,0,8,0" />
                <Button Content="{Binding Oosu10SelectedCountText}"
                        Style="{StaticResource PrimaryButton}" Command="{Binding ApplyOosu10Command}" />
            </WrapPanel>
        </Grid>

        <!-- Filtros -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12,8" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Buscar" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="240" Style="{StaticResource BaseTextBox}" VerticalAlignment="Center"
                         Text="{Binding Oosu10Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Grupo" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="18,0,8,0" />
                <ComboBox Width="230" VerticalAlignment="Center"
                          Style="{StaticResource FilterComboBox}"
                          ItemsSource="{Binding Oosu10GroupOptions}"
                          SelectedItem="{Binding Oosu10Group, Mode=TwoWay}" />
                <CheckBox Content="Só pendentes (ocultar já ativos)" Style="{StaticResource BaseCheckBox}"
                          IsChecked="{Binding Oosu10OnlyPending, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="18,0,0,0" />
                <TextBlock Text="{Binding Oosu10Visible.Count, StringFormat={}{0} item(ns)}"
                           Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="18,0,0,0" />
            </WrapPanel>
        </Border>

        <!-- Lista à esquerda, detalhe à direita -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,12,0">
                <Grid>
                    <ListBox ItemsSource="{Binding Source={StaticResource GroupedOosu10}}"
                             SelectedItem="{Binding SelectedOosu10, Mode=TwoWay}"
                             Style="{StaticResource BaseListBox}"
                             ItemContainerStyle="{StaticResource BaseListBoxItem}"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"
                                                   Margin="4,12,0,6" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SelectableCard}" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource BaseCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Top" Margin="0,2,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                                                       FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,5,0,0">
                                                <Border Background="{Binding AdviceBrush}" Style="{StaticResource BadgeBorder}">
                                                    <TextBlock Text="{Binding AdviceDisplay}"
                                                               Foreground="{StaticResource OnAccentBrush}"
                                                               FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Background="{Binding StateBrush}" Style="{StaticResource BadgeBorder}">
                                                    <TextBlock Text="{Binding StateText}"
                                                               Foreground="{StaticResource OnAccentBrush}"
                                                               FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding PresetText}" Style="{StaticResource MutedText}"
                                                           FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding RebootText}" Style="{StaticResource MutedText}"
                                                   FontSize="10" VerticalAlignment="Top" Margin="8,2,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Nenhum ajuste com esses filtros." Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoOosu10Items, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- Detalhe -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedOosu10.Title, TargetNullValue=Selecione um ajuste}"
                                   Style="{StaticResource TitleText}" FontSize="20" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,0">
                            <Border Background="{Binding SelectedOosu10.AdviceBrush}" Style="{StaticResource BadgeBorder}">
                                <TextBlock Text="{Binding SelectedOosu10.AdviceDisplay}"
                                           Foreground="{StaticResource OnAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="{Binding SelectedOosu10.StateBrush}" Style="{StaticResource BadgeBorder}">
                                <TextBlock Text="{Binding SelectedOosu10.StateText}"
                                           Foreground="{StaticResource OnAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource BadgeBorder}">
                                <TextBlock Text="{Binding SelectedOosu10.Group}" FontSize="11" />
                            </Border>
                            <Border Style="{StaticResource BadgeBorder}"
                                    Visibility="{Binding SelectedOosu10.RequiresReboot, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="exige reinício" FontSize="11" />
                            </Border>
                            <Border Style="{StaticResource BadgeBorder}"
                                    Visibility="{Binding SelectedOosu10.NeedsAdmin, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedOosu10.AdminText}" FontSize="11" />
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="O que faz" Style="{StaticResource SectionTitle}" Margin="0,18,0,4" />
                        <TextBlock Text="{Binding SelectedOosu10.Detail}" LineHeight="20" FontSize="13"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Explicação completa" Style="{StaticResource SectionTitle}" Margin="0,18,0,4" />
                        <TextBlock Text="{Binding SelectedOosu10.Explanation}" LineHeight="20" FontSize="13"
                                   TextWrapping="Wrap" />

                        <Border Background="{StaticResource CardAltBrush}" CornerRadius="6" Padding="12"
                                Margin="0,16,0,0"
                                Visibility="{Binding SelectedOosu10.HasNote, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Atenção" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource CautionBrush}" />
                                <TextBlock Text="{Binding SelectedOosu10.Note}" Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="O que muda no Windows" Style="{StaticResource SectionTitle}" Margin="0,18,0,4" />
                        <Border Background="{StaticResource CardAltBrush}" CornerRadius="6" Padding="10">
                            <TextBlock Text="{Binding SelectedOosu10.OpsText}" Style="{StaticResource MonoText}"
                                       FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Como fica ao reverter" Style="{StaticResource SectionTitle}" Margin="0,18,0,4" />
                        <Border Background="{StaticResource CardAltBrush}" CornerRadius="6" Padding="10">
                            <TextBlock Text="{Binding SelectedOosu10.RestoreText}" Style="{StaticResource MonoText}"
                                       FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="12"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Como desfazer" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" FontSize="12"
                                           TextWrapping="Wrap"
                                           Text="Marque o item e use &quot;Reverter selecionados&quot; para voltar ao estado anterior. Em Backups / Desfazer você também pode voltar tudo de uma vez." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
