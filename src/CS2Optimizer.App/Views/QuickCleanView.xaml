<UserControl x:Class="CS2Optimizer.App.Views.QuickCleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,32" MaxWidth="1100" HorizontalAlignment="Stretch">

            <TextBlock Text="LIMPEZA RÁPIDA" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="Tirar o lixo sem quebrar nada" Style="{StaticResource TitleText}"
                       Margin="0,6,0,0" />
            <TextBlock Style="{StaticResource SubtitleText}" Margin="0,6,0,0" TextWrapping="Wrap"
                       HorizontalAlignment="Left" MaxWidth="760"
                       Text="Marque o que quer limpar e confirme. Tudo aqui é cache: o Windows e os programas recriam sozinhos. Nenhum arquivo pessoal é tocado." />

            <!-- Lista de caches -->
            <Border Style="{StaticResource CardBorder}" Margin="0,20,0,16" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Caches encontrados nesta máquina" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding QuickCleanSummary}" Style="{StaticResource MutedText}"
                                       FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Marcar todos" Style="{StaticResource LinkButton}"
                                    Command="{Binding SelectAllQuickCleanCommand}" Margin="0,0,12,0" />
                            <Button Content="Desmarcar" Style="{StaticResource LinkButton}"
                                    Command="{Binding ClearQuickCleanCommand}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding QuickClean}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GhostCard}" Padding="14" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource BaseCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CurrentState}" Style="{StaticResource MutedText}"
                                                           FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}"
                                                   FontSize="11" Margin="26,6,0,0" TextWrapping="Wrap" />
                                        <Border Background="{StaticResource CautionSoftBrush}"
                                                BorderBrush="{StaticResource CautionBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,6" Margin="26,8,0,0"
                                                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{StaticResource CautionBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Nenhum cache para limpar agora — nada encontrado ou tudo já está limpo."
                               Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Visibility="{Binding QuickCleanEmpty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Ação -->
            <Border Style="{StaticResource CardBorder}" Padding="20" BorderBrush="{StaticResource AccentLineBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding QuickCleanActionText}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Antes de limpar, o programa mostra a lista para confirmar. O cache de shader fica desmarcado por padrão." />
                    </StackPanel>

                    <Button Grid.Column="1" Content="Limpar selecionados" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyQuickCleanCommand}" VerticalAlignment="Center"
                            ToolTip="Limpa os caches marcados. Você confirma a lista antes." />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
