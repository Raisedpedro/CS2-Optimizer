<UserControl x:Class="CS2Optimizer.App.Views.QuickCleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho fixo: título e ação sempre visíveis, mesmo sem tela cheia -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="Limpeza rápida" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,0"
                           HorizontalAlignment="Left" MaxWidth="820"
                           Text="Marque o que quer limpar e confirme. Tudo aqui é cache: o Windows e os programas recriam sozinhos. Nenhum arquivo pessoal é tocado." />
            </StackPanel>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Marcar todos" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SelectAllQuickCleanCommand}" Margin="0,0,8,0" />
                <Button Content="Desmarcar" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearQuickCleanCommand}" Margin="0,0,8,0" />
                <Button Content="{Binding QuickCleanActionText}"
                        Style="{StaticResource PrimaryButton}" Command="{Binding ApplyQuickCleanCommand}"
                        ToolTip="Limpa os caches marcados. Você confirma a lista antes." />
            </WrapPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

                <Border Style="{StaticResource CardBorder}" Padding="20">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Caches encontrados nesta máquina" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding QuickCleanSummary}" Style="{StaticResource MutedText}"
                                       FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding QuickClean}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GhostCard}" Padding="14" Margin="0,0,0,8">
                                        <StackPanel>
                                            <CheckBox Style="{StaticResource BaseCheckBox}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding CurrentState}" Style="{StaticResource MutedText}"
                                                               FontSize="11" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </CheckBox>
                                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}"
                                                       FontSize="11" Margin="26,6,0,0" TextWrapping="Wrap" />
                                            <Border Background="{StaticResource CautionSoftBrush}"
                                                    BorderBrush="{StaticResource CautionBrush}" BorderThickness="1"
                                                    CornerRadius="8" Padding="10,6" Margin="26,8,0,0"
                                                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="11"
                                                           Foreground="{StaticResource CautionBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Nenhum cache para limpar agora — nada encontrado ou tudo já está limpo."
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                   Visibility="{Binding QuickCleanEmpty, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
