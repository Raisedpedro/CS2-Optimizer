<UserControl x:Class="CS2Optimizer.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="Diagnóstico" Style="{StaticResource TitleText}" />
                <TextBlock Style="{StaticResource SubtitleText}" Margin="0,4,0,0"
                           Text="Relatório somente leitura da máquina. Salve em .txt para guardar o antes/depois. Nenhuma alteração é feita nesta tela." />
            </StackPanel>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Salvar relatório" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveReportCommand}" Margin="0,0,8,0" />
                <Button Content="Reler a máquina" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ScanCommand}" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,12,0">
                <ListBox ItemsSource="{Binding Diagnostics}" Style="{StaticResource BaseListBox}"
                         ItemContainerStyle="{StaticResource BaseListBoxItem}"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" Foreground="{Binding Foreground}"
                                       FontWeight="{Binding Weight}" Margin="{Binding Margin}"
                                       FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Problemas encontrados" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                   Text="{Binding ProblemCountText}" />
                        <ItemsControl ItemsSource="{Binding Problems}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource RiskyBrush}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Arquivos" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                   Text="O log completo da sessão fica na pasta do programa (ou em LocalAppData, se a pasta não aceitar escrita)." />
                        <Button Content="Abrir arquivo de log" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding OpenLogFileCommand}" />
                        <Button Content="Abrir pasta do log" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                Command="{Binding OpenLogFolderCommand}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                   Text="{Binding LastScanLabel}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
