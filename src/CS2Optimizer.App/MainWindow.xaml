<Window x:Class="CS2Optimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CS2Optimizer.App.Views"
        Title="CS2 / Windows Optimizer"
        Width="1200" Height="800" MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/CS2Optimizer;component/Assets/icone.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/CS2Optimizer;component/Assets/icone.ico" Width="42" Height="42"
                       Margin="0,0,14,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       ToolTip="CS2 / Windows Optimizer" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CS2 / Windows Optimizer" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SubtitleText}" FontSize="12" Margin="0,3,0,0"
                               Text="Diagnóstico e ajustes seguros e reversíveis para CS2 no Windows 10/11" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource CardBrush}" Style="{StaticResource BadgeBorder}"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding AdminText}" Foreground="{Binding AdminBrush}"
                                   FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12" />
                    <Button Content="Log" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleLogCommand}" Margin="0,0,8,0"
                            ToolTip="Mostra ou oculta o log da sessão." />
                    <Button Content="Reler a máquina" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ScanCommand}" Margin="0,0,8,0"
                            ToolTip="Faz uma leitura completa (hardware, registro, Steam, BCD e mitigações)." />
                    <Button Content="{Binding RecommendedActionText}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyRecommendedCommand}"
                            ToolTip="Aplica tudo o que é recomendado: correções recomendadas e os ajustes do O&amp;O sugeridos para CS2 que ainda estão inativos. Nada opcional ou de risco entra aqui. Avisa no fim se precisa reiniciar." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra de progresso global -->
        <Border Grid.Row="1" Background="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="0,0,0,1" Padding="22,12"
                Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="{StaticResource AccentBrush}" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BusyTitle}" FontWeight="SemiBold" FontSize="14"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BusyDetail}" Style="{StaticResource MutedText}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource AccentBrush}"
                            Style="{StaticResource BadgeBorder}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProgressPercentText}" Foreground="{StaticResource OnAccentBrush}"
                                   FontWeight="Bold" FontSize="12" />
                    </Border>
                </Grid>
                <ProgressBar Grid.Row="1" Height="8"
                             Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                             Style="{StaticResource KuduProgressBar}" />
            </Grid>
        </Border>

        <!-- Aviso de reinício pendente -->
        <Border Grid.Row="2" Background="{StaticResource CautionSoftBrush}"
                BorderBrush="{StaticResource CautionBrush}" BorderThickness="0,0,0,1" Padding="22,10"
                Visibility="{Binding NeedReboot, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⟳" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{StaticResource CautionBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding RebootNoticeText}" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource CautionBrush}" />
            </StackPanel>
        </Border>

        <!-- Abas horizontais -->
        <TabControl Grid.Row="3" Style="{StaticResource TopTabControl}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="Resumo" Style="{StaticResource TopTabItem}">
                <views:SummaryView />
            </TabItem>
            <TabItem Header="Correções" Style="{StaticResource TopTabItem}">
                <views:FixesView />
            </TabItem>
            <TabItem Header="Mitigações CPU" Style="{StaticResource TopTabItem}">
                <views:MitigationsView />
            </TabItem>
            <TabItem Header="O&amp;O ShutUp10" Style="{StaticResource TopTabItem}">
                <views:Oosu10View />
            </TabItem>
            <TabItem Header="Diagnóstico" Style="{StaticResource TopTabItem}">
                <views:DiagnosticsView />
            </TabItem>
            <TabItem Header="Checklist" Style="{StaticResource TopTabItem}">
                <views:ChecklistView />
            </TabItem>
            <TabItem Header="Backups / Desfazer" Style="{StaticResource TopTabItem}">
                <views:BackupsView />
            </TabItem>
        </TabControl>

        <!-- Log da sessão -->
        <Border Grid.Row="4" Background="{StaticResource LogBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8"
                Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Log da sessão" Style="{StaticResource SectionTitle}"
                               FontSize="13" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Abrir arquivo" Style="{StaticResource LinkButton}"
                                Command="{Binding OpenLogFileCommand}" Margin="0,0,10,0" />
                        <Button Content="Abrir pasta" Style="{StaticResource LinkButton}"
                                Command="{Binding OpenLogFolderCommand}" Margin="0,0,10,0" />
                        <Button Content="Ocultar" Style="{StaticResource LinkButton}"
                                Command="{Binding ToggleLogCommand}" />
                    </StackPanel>
                </Grid>
                <ListBox ItemsSource="{Binding LogItems}" Height="185"
                         Style="{StaticResource LogListBox}" ItemContainerStyle="{StaticResource LogListBoxItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" Foreground="{Binding Foreground}"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Barra de estado -->
        <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  " Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" MaxWidth="620" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentSoftBrush}" Style="{StaticResource BadgeBorder}"
                            BorderBrush="{StaticResource AccentLineBrush}"
                            Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding PendingCountText}" Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="Trabalhando..." Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource DangerSoftBrush}" Style="{StaticResource BadgeBorder}"
                            BorderBrush="{StaticResource DangerBrush}"
                            Visibility="{Binding NeedReboot, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding NeedRebootText}" Foreground="{StaticResource RiskyBrush}"
                                   FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Text="{Binding LastScanDisplay}" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
